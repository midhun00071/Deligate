# =====================================================
# DELIGATE ENVIRONMENT TEMPLATE
# Copy this file to .env for local development.
# NEVER put real secrets in this template.
# =====================================================

# -----------------------------------------------------
# Application
# -----------------------------------------------------

NODE_ENV=development
APP_ENV=development

# -----------------------------------------------------
# Deligate API / NestJS
# -----------------------------------------------------

API_PORT=3000
API_HOST=0.0.0.0

# -----------------------------------------------------
# Expo Mobile
#
# WARNING:
# Anything beginning with EXPO_PUBLIC_ is visible
# inside the compiled mobile application.
# Never place private keys here.
# -----------------------------------------------------

EXPO_PUBLIC_API_URL=http://localhost:3000

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------
# Supabase - SERVER ONLY
# -----------------------------------------------------

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Never expose this to Expo/mobile.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------
# eidStack - SERVER ONLY
# -----------------------------------------------------

# mock = development before sandbox access
# live = real eidStack sandbox integration
EIDSTACK_MODE=mock

EIDSTACK_BASE_URL=https://test.e-idstack.com/api/v1

# Provided by eidStack on hackathon day.
EIDSTACK_API_KEY=

# Tenant IDs will be populated after the real
# organizations/tenants are provisioned.
EIDSTACK_DELIVERY_TENANT_ID=
EIDSTACK_BUILDING_TENANT_ID=

# -----------------------------------------------------
# Deligate application configuration
# -----------------------------------------------------

APP_SCHEME=deligate
