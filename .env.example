NODE_ENV=development
APP_ENV=development

# NestJS API
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Expo
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Supabase - safe for client
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase - server
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# eidStack - server only
EIDSTACK_MODE=mock
EIDSTACK_BASE_URL=https://test.e-idstack.com/api/v1
EIDSTACK_API_KEY=
EIDSTACK_DELIVERY_TENANT_ID=
EIDSTACK_BUILDING_TENANT_ID=
EIDSTACK_DELIVERY_ORGANIZATION_ID=
EIDSTACK_RIDER_SCHEMA_ID=
EIDSTACK_RIDER_CREDENTIAL_DEFINITION_ID=
EIDSTACK_ACCESS_SCHEMA_ID=
EIDSTACK_ACCESS_CREDENTIAL_DEFINITION_ID=
# Set true only after confirming this existing definition supports revocation.
EIDSTACK_RIDER_REVOCATION_SUPPORTED=
EIDSTACK_TIMEOUT_MS=8000

# App
APP_SCHEME=deligate
